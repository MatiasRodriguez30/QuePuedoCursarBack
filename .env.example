# Copiar a ".env" (nunca se versiona) y completar con los valores reales.

# API key de Resend (resend.com) para enviar el mail de "olvidé mi contraseña".
# Si se deja vacío, el sistema sigue funcionando pero no envía mails (se loguea
# un warning y el endpoint /auth/forgot-password responde igual, sin fallar).
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend.
MAIL_FROM=Qué Puedo Cursar <no-reply@takana.online>

# URL del frontend (a donde apunta el link del mail de reseteo).
FRONTEND_URL=https://app.takana.online

# ── Bot de Telegram (opcional) ───────────────────────────────────────────────
# Si falta el token o el chat id, el bot no arranca y no se mandan avisos.
# 1) Crear el bot hablando con @BotFather (/newbot) y pegar acá el token.
# 2) Escribirle cualquier cosa al bot y correr `python scripts/telegram_chat_id.py`
#    para ver tu chat id; pegarlo en TELEGRAM_CHAT_ID.
# El token es una clave: va sólo en este .env (que no se versiona).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email de TU cuenta en Qué Puedo Cursar: con ella responden /hoy, /manana y /cursar.
TELEGRAM_USUARIO_EMAIL=
# Panel del servidor de Minecraft (opcional; estos son los valores por defecto). Solo en la red de casa / Tailscale.
# PANEL_MC_URL=https://192.168.1.44:8443
# PANEL_MC_URL_TAILSCALE=https://100.107.211.46:8443
# PANEL_MC_USUARIO=Leciloft
