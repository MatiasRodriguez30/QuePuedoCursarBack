# Copiar a ".env" (nunca se versiona) y completar con los valores reales.

# API key de Resend (resend.com) para enviar el mail de "olvidé mi contraseña".
# Si se deja vacío, el sistema sigue funcionando pero no envía mails (se loguea
# un warning y el endpoint /auth/forgot-password responde igual, sin fallar).
RESEND_API_KEY=

# Remitente. El dominio tiene que estar verificado en Resend.
MAIL_FROM=Qué Puedo Cursar <no-reply@takana.online>

# URL del frontend (a donde apunta el link del mail de reseteo).
FRONTEND_URL=https://app.takana.online
